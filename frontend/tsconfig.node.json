{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    // `tsc -b` EMITS vite.config.js from vite.config.ts (composite), and Vite
    // prefers that .js over the .ts when both exist — so this target is what the
    // build config actually runs as. ES2020 matches the Node that runs Vite and
    // keeps modern syntax (?? , matchAll) intact instead of downleveling to ES5.
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}